RewriteEngine On

# Remove index.html from public URLs in a single redirect.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[\s?]) [NC]
RewriteRule ^(.*/)?index\.html$ https://orizgroup.com.br/$1 [R=301,L,NE]

# Keep one HTTPS hostname for every public page.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^orizgroup\.com\.br$ [NC]
RewriteRule ^ https://orizgroup.com.br%{REQUEST_URI} [R=301,L,NE]
